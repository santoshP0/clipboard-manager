{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory",
  "version": "0.1.0",
  "identifier": "app.memory.clipboard",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Memory",
        "width": 1120,
        "height": 720,
        "minWidth": 860,
        "minHeight": 520,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": true
      },
      {
        "label": "quick",
        "title": "Memory Quick Access",
        "width": 800,
        "height": 640,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "menu",
        "title": "Memory Menu",
        "width": 340,
        "height": 520,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
